{
  "name": "fluidsim-pneumatics-mcp",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "bin": {
    "fluidsim-mcp": "./dist/bin/fluidsim-mcp.js"
  },
  "scripts": {
    "dev": "tsx bin/fluidsim-mcp.ts serve --transport http --port 3000 --host 0.0.0.0 --mode authoring --init-workspace",
    "start": "node dist/bin/fluidsim-mcp.js serve --transport http --port 3000 --host 0.0.0.0 --mode authoring --init-workspace",
    "build": "esbuild bin/fluidsim-mcp.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bin/fluidsim-mcp.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "mcp": "tsx bin/fluidsim-mcp.ts",
    "inspect-ct": "tsx scripts/inspect-ct.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
